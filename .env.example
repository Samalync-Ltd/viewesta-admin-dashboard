# Viewesta admin dashboard (Vite).
# Copy to .env:  cp .env.example .env
# Only variables starting with VITE_ are read, at dev-server start / build time.

# ── Backend API ───────────────────────────────────────────────────────────────
# Full URL including /api/v1. For local dev you can use "/api/v1" instead to go
# through the Vite dev proxy (see vite.config.ts) and avoid CORS.
VITE_API_BASE_URL=

# Set to true only for local mock data (no backend calls).
VITE_USE_MOCK=false

# ── Firebase (push notifications) ─────────────────────────────────────────────
# Public web config of the "viewesta" Firebase project (it ships in the browser
# bundle, so it isn't secret). Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=viewesta
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → public key pair.
VITE_FIREBASE_VAPID_KEY=
